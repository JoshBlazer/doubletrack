# fixture apps
/fixtures/apps/*/log/*
/fixtures/apps/*/tmp/*
/fixtures/apps/*/storage/*
/fixtures/apps/*/db/*.sqlite3*
/fixtures/apps/*/.bundle/
/fixtures/apps/planted/*/log/*
/fixtures/apps/planted/*/tmp/*
/fixtures/apps/planted/*/db/*.sqlite3*
