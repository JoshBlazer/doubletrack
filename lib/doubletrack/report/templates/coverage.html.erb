<% routes = Array(run.dig("coverage", "routes")).sort_by { |r| [r["hit"] ? 1 : 0, r["path"].to_s, r["verb"].to_s] } -%>
<h1>Route coverage: <%= pct(run.dig("coverage", "ratio")) %></h1>
<p><%= run.dig("coverage", "routes_hit").to_i %> of <%= run.dig("coverage", "routes_total").to_i %> application routes were exercised by the replayed sessions. Behavior on routes that were never requested was not compared. Unexercised routes are listed first.</p>
<table>
  <caption>Application routes (internal and <code>/rails/</code> routes excluded)</caption>
  <thead><tr><th scope="col">Exercised</th><th scope="col">Verb</th><th scope="col">Path</th><th scope="col">Controller#action</th><th scope="col">Requests (control A)</th></tr></thead>
  <tbody>
<% routes.each do |r| -%>
    <tr<%= ' class="unhit"' unless r["hit"] %>><td><%= r["hit"] ? "yes" : "no" %></td><td><%= h(r["verb"]) %></td><td><code><%= h(r["path"]) %></code></td><td><code><%= h("#{r["controller"]}##{r["action"]}") %></code></td><td><%= r["hits"].to_i %></td></tr>
<% end -%>
  </tbody>
</table>

<% if (fidelity = run["capture_fidelity"]) -%>
<section aria-labelledby="fidelity-heading">
  <h2 id="fidelity-heading">Capture fidelity</h2>
  <p><%= fidelity["matched"] %> of <%= fidelity["requests"] %> captured requests replayed on control A with the HTTP status their test saw. A mismatch means the replay environment differs from the test for that request (an app-level stub, a sign-in helper, test-only setup). It isn't a finding, but the session doesn't exercise what its test did.</p>
<% if fidelity["mismatches"].any? -%>
  <table>
    <caption>Captured requests that replayed differently from their test</caption>
    <thead><tr><th scope="col">Session</th><th scope="col">#</th><th scope="col">Request</th><th scope="col">In the test</th><th scope="col">Replayed</th></tr></thead>
    <tbody>
<% fidelity["mismatches"].each do |m| -%>
      <tr><td><code><%= h(m["session_id"]) %></code></td><td><%= m["request_index"] %></td><td><code><%= h(m["request"]) %></code></td><td><%= h(m["test_status"]) %></td><td><%= h(m["replay_status"]) %></td></tr>
<% end -%>
    </tbody>
  </table>
<% end -%>
</section>
<% end -%>
