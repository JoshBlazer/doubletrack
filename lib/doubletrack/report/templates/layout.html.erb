<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<title><%= h(@title) %> · Doubletrack · <%= h(run.dig("app", "name")) %></title>
<link rel="stylesheet" href="<%= @root %>style.css">
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
<header class="topbar">
  <div class="wrap topbar-inner">
    <a class="brand" href="<%= @root %>index.html"><%= icon(:logo) %>Doubletrack</a>
    <p class="context"><span><%= h(run.dig("app", "name")) %></span><span class="version-chip">Rails <%= h(twin_version("control_a")) %> → <%= h(twin_version("candidate_b")) %></span></p>
    <nav aria-label="Report sections">
      <ul>
<% NAV.each do |href, label| -%>
        <li><a href="<%= @root %><%= href %>"<%= ' aria-current="page"' if @current == href %>><%= label %></a></li>
<% end -%>
      </ul>
    </nav>
  </div>
</header>
<main id="main" class="wrap">
<%= yield %>
</main>
<footer class="wrap site-footer">
  <p>Run <code><%= h(run["run_id"]) %></code> · seed <code><%= h(run["seed"]) %></code> · Doubletrack <%= h(run["doubletrack_version"]) %>. Static report; works offline and without JavaScript.</p>
</footer>
<script src="<%= @root %>enhance.js" defer></script>
</body>
</html>
