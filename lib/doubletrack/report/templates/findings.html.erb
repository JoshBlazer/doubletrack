<div class="page-head">
  <p class="eyebrow">Rails <%= twin_version_html("control_a") %> → <%= twin_version_html("candidate_b") %></p>
  <h1>Findings</h1>
  <p>Each finding groups one kind of difference (same route, path and change shape) across every session where it appeared. Severity: data-changing &gt; user-visible &gt; cosmetic.</p>
</div>

<form class="filters" hidden aria-label="Filter findings by severity">
  <fieldset>
    <legend>Show</legend>
<% Diff::Severity::ORDER.each do |sev| -%>
    <label><input type="checkbox" name="severity" value="<%= sev %>" checked> <span class="dot dot-<%= sev %>" aria-hidden="true"></span><%= SEVERITY_LABELS[sev] %> (<%= count(sev) %>)</label>
<% end -%>
  </fieldset>
</form>

<% if new_changes.any? -%>
<section class="card" aria-labelledby="changes-heading">
  <div class="card-head"><h2 id="changes-heading">Changes (<%= new_changes.size %>)</h2></div>
  <p class="muted">A change is one difference, wherever it appeared: findings with the same channel, path and change, on any route.</p>
<% new_changes.each do |c| -%>
  <article class="change" id="<%= h(c["id"]) %>" aria-labelledby="<%= h(c["id"]) %>-title">
    <h3 id="<%= h(c["id"]) %>-title"><%= badge(c["severity"]) %> <%= h(plain_change(c)) %></h3>
    <p class="muted"><code><%= h(c["path"]) %></code> <%= change_where_html(c) %> · <%= c["findings"].size %> finding<%= "s" unless c["findings"].size == 1 %> · <%= h(change_verified(c)) %> · <code><%= h(c["id"]) %></code></p>
<% if c["causes"].to_a.any? -%>
    <p>Likely cause<%= "s" if c["causes"].size > 1 %>:</p>
    <ul><% c["causes"].each do |cause| %><li><%= cause_html(cause) %></li><% end %></ul>
<% else -%>
    <p class="muted"><%= h(no_cause_text(c)) %></p>
<% end -%>
<% list = change_findings(c) -%>
<% if list.size > 8 -%>
    <details><summary>Its <%= list.size %> findings, one per route</summary>
<% end -%>
    <ul class="change-findings"><% list.each do |f| %><li><a href="<%= finding_href(f) %>"><code><%= h(f["route"]) %></code></a> <%= repro_status_html(f) %></li><% end %></ul>
<% if list.size > 8 -%>
    </details>
<% end -%>
  </article>
<% end -%>
</section>
<% end -%>

<% grouped_findings.each do |sev, list| -%>
<section class="card table-card severity-group" data-severity="<%= sev %>" aria-labelledby="group-<%= sev %>">
  <div class="card-head">
    <h2 id="group-<%= sev %>" class="group-head"><%= badge(sev) %> <%= list.size %> <%= sev %></h2>
  </div>
<% if list.empty? -%>
  <p class="muted pad">None.</p>
<% else -%>
  <table>
    <thead><tr><th scope="col">Finding</th><th scope="col">Route</th><th scope="col" class="num">Sessions</th><th scope="col">Reproduction</th><th scope="col">ID</th></tr></thead>
    <tbody>
<% list.each do |f| -%>
      <tr data-severity="<%= sev %>">
        <td class="finding-cell"><a href="<%= finding_href(f) %>"><%= h(plain(f)) %></a><code><%= h(f["path"]) %></code></td>
        <td><code><%= h(f["route"]) %></code></td>
        <td class="num"><%= f["sessions"] %></td>
        <td><%= repro_status_html(f) %></td>
        <td><code><%= h(f["id"]) %></code></td>
      </tr>
<% end -%>
    </tbody>
  </table>
<% end -%>
</section>
<% end -%>

<section class="card<%= " table-card" if accepted_findings.any? %>" aria-labelledby="accepted-heading">
  <div class="card-head">
    <h2 id="accepted-heading">Accepted (<%= accepted_findings.size %>)</h2>
  </div>
<% if accepted_findings.empty? -%>
  <p class="muted">No findings are accepted in <code><%= h(baseline_name) %></code>.</p>
<% else -%>
  <p class="pad-x">Listed in <code><%= h(baseline_name) %></code> as expected. They don't count toward the verdict or the exit code.</p>
  <table>
    <thead><tr><th scope="col">Finding</th><th scope="col">Severity</th><th scope="col">Reason</th><th scope="col">Accepted by</th><th scope="col">ID</th></tr></thead>
    <tbody>
<% accepted_findings.each do |f| -%>
      <tr>
        <td class="finding-cell"><a href="<%= finding_href(f) %>"><%= h(plain(f)) %></a><code><%= h(f["title"]) %></code></td>
        <td><%= badge(f["severity"]) %></td>
        <td><%= h(f.dig("accepted", "reason")) %></td>
        <td><%= h(f.dig("accepted", "author")) %>, <%= h(f.dig("accepted", "accepted_at")) %></td>
        <td><code><%= h(f["id"]) %></code></td>
      </tr>
<% end -%>
    </tbody>
  </table>
<% end -%>
<% if stale_ids.any? -%>
  <p<%= ' class="pad"' if accepted_findings.any? %>>Stale baseline entries (accepted, but not seen in this run; the sessions that triggered them may not have run): <% stale_ids.each_with_index do |id, i| %><%= ", " if i > 0 %><code><%= h(id) %></code><% end %>.</p>
<% end -%>
</section>
