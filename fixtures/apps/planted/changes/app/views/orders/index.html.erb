<h1>Orders</h1>
<p><%= pluralize(@summary["count"], "order") %>, <%= number_to_currency(@summary["total_cents"] / 100.0) %> total</p>

<% if @orders.any? %>
  <table>
    <thead><tr><th>#</th><th>Customer</th><th>Total</th><th>Status</th></tr></thead>
    <tbody>
      <% @orders.each do |order| %>
        <tr>
          <td><%= link_to order.id, order %></td>
          <% if Planted.on? %>
          <td   data-order="<%= order.id %>"
                class="email"><%= order.user.email %></td>
          <% else %>
          <td class="email" data-order="<%= order.id %>"><%= order.user.email %></td>
          <% end %>
          <td><%= order.total %> <%= order.currency %></td>
          <td><%= order.status %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>No orders yet.</p>
<% end %>
